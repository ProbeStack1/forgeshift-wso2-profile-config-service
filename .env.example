SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082

# --- MongoDB (same Atlas cluster as discovery service) ---
MONGODB_URI=mongodb://localhost:27017/forgeshift_profiles
MONGODB_DATABASE=forgeshift_profiles

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Multi-tenancy ---
TENANT_HEADER=X-Partner-Id
DEFAULT_TENANT=probestack

# --- Audit ---
AUDIT_ENABLED=true
